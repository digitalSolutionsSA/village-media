# Optional. The same Supabase project as the ad platform, for the live "screens online /
# ads running" line and any packages set up under Packages. Leave blank and the page uses
# the brochure figures and the Standard / Premium packages built into src/Pitch.tsx.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Where the "Sign up" buttons go, e.g. https://<ad-platform>/admin/signup
# (?package=<id> is added for package buttons). Leave blank and they open the on-page sign-up form.
VITE_SIGNUP_URL=

# Server-side only (never VITE_): the sign-up form emails sales through Resend.
# Set these in Netlify → Site configuration → Environment variables; here only for `npm run dev`.
RESEND_API_KEY=
# A sender on a domain verified in Resend. Default: Village Media <website@vm-group.co.za>
RESEND_FROM=
# Default: sales@vm-group.co.za
RESEND_TO=
